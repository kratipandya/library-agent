# Secrets — never commit
.env
*.tfvars

# Terraform — state can contain resource IDs/secrets; plugins are per-machine
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Python
.venv/
__pycache__/
.ruff_cache/
*.egg-info/

# Data artifacts (downloaded books, chunks, indexes — rebuildable, too big for git)
data/
*.faiss

# macOS
.DS_Store
